# Configuration Squid en mode proxy explicite
# Généré par Ansible

# Port HTTP pour le proxy explicite
http_port {{ squid_http_port }}

# ACL pour la whitelist
acl whitelist_domains dstdomain "{{ squid_whitelist_file }}"

# ACL standards
acl SSL_ports port 443
acl Safe_ports port 80          # http
acl Safe_ports port 443         # https
acl CONNECT method CONNECT

# Règles de sécurité de base
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# Autoriser localhost pour la gestion
http_access allow localhost manager
http_access deny manager

# Règle principale: autoriser UNIQUEMENT les domaines de la whitelist
http_access allow whitelist_domains

# Refuser tout le reste
http_access deny all

# Configuration du cache
cache_dir ufs /var/spool/squid 100 16 256
coredump_dir /var/spool/squid

# Paramètres de journalisation
access_log /var/log/squid/access.log squid
cache_log /var/log/squid/cache.log

# Paramètres de rafraîchissement du cache
refresh_pattern ^ftp:           1440    20%     10080
refresh_pattern ^gopher:        1440    0%      1440
refresh_pattern -i (/cgi-bin/|\?) 0     0%      0
refresh_pattern .               0       20%     4320

# Masquer la version de Squid
httpd_suppress_version_string on

# Paramètres de performance
maximum_object_size 4096 KB
minimum_object_size 0 KB
maximum_object_size_in_memory 512 KB

# Paramètres DNS
dns_nameservers 8.8.8.8 8.8.4.4
