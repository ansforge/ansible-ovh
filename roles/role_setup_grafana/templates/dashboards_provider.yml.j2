# {{ ansible_managed }}
apiVersion: 1

providers:
  - name: supervision
    orgId: 1
    folder: Supervision
    folderUid: supervision
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 60
    options:
      path: {{ grafana_dashboards_dir }}
      foldersFromFilesStructure: false
