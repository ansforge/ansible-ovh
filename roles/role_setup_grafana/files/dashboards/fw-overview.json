        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-supervision"
          },
          "query": "from(bucket: \"supervision\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"percent_packet_loss\")\n  |> filter(fn: (r) => r.fw_name =~ /^${fw:regex}$/)\n  |> map(fn: (r) => ({r with _value: 100.0 - r._value}))\n  |> group(columns: [\"fw_name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
