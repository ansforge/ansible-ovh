      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-supervision"
          },
          "query": "from(bucket: \"supervision\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"fw_interface\")\n  |> filter(fn: (r) => r._field == \"if_admin_status\" or r._field == \"if_oper_status\" or r._field == \"if_speed\")\n  |> filter(fn: (r) => r.fw_name =~ /^${fw:regex}$/)\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"fw_name\", \"if_name\", \"if_alias\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"fw_name\", \"if_name\"])\n  |> keep(columns: [\"fw_name\", \"if_name\", \"if_alias\", \"if_admin_status\", \"if_oper_status\", \"if_speed\"])"
        }
      ],
