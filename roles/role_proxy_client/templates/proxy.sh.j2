# Accès Internet sortant via le proxy Squid de la landing zone (domaines en liste blanche uniquement).
export http_proxy="{{ proxy_url }}"
export https_proxy="{{ proxy_url }}"
export HTTP_PROXY="{{ proxy_url }}"
