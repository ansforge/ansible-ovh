# Configuration du repository local AlmaLinux
{% for alias in repo_http_alias_list %}
Alias /{{ alias }} {{ repo_base_path }}/{{ alias }}

<Directory {{ repo_base_path }}/{{ alias }}>
    # Permet de lister les fichiers (important pour DNF/YUM)
    Options Indexes FollowSymLinks
    AllowOverride None
    
    # Restriction d'accès aux VLANs autorisés
    <RequireAny>
        {% for net in allowednets %}
        Require ip {{ net }}
        {% endfor %}
    </RequireAny>
</Directory>
{% endfor %}
