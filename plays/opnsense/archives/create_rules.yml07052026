---
# ---------------------------------------------------------------------------
# create_vlan.yml
# Crée VLAN + Assignment + Static IPv4 + Activation + VIP CARP sur master et slave
# Usage : ansible-playbook -i inventory.yml create_vlan.yml -e @matrice_de_vlan.yml
# ---------------------------------------------------------------------------

- name: Creation VLAN et VIP CARP OPNsense
  hosts: opnsense
  gather_facts: false
  serial: 1

  vars:
    api_host: "{{ ansible_host }}"
    api_key: "{{ opn_api_key }}"
    api_secret: "{{ opn_api_secret }}"
    opn_ssl_verify: false
    opn_timeout: 30
    carp_password: "Si0TbNVUoQ6yQMIp0R7R"
    ssh_key: "/home/almalinux/.ssh/opnsense_key"
    vlan_descr: "{{ vlan_name }}_vlan{{ vlan_id }}"
    vlan_device: "vmx0_vlan{{ vlan_id }}"
    ip_locale: "{{ ip_master if membre == 1 else ip_slave }}"
    peer_carp: "{{ ip_slave if membre == 1 else ip_master }}"
    vip_mask: "{{ vip.split('/')[1] }}"

  tasks:

    # -----------------------------------------------------------------------
    # ETAPE 1 - Création device VLAN
    # -----------------------------------------------------------------------
    - name: "Récupération des VLANs existants"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vlan_settings/searchItem"
        method: GET
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
      register: existing_vlans

    - name: "Création device VLAN {{ vlan_descr }}"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vlan_settings/addItem"
        method: POST
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
        body_format: json
        body:
          vlan:
            if: "vmx0"
            tag: "{{ vlan_id }}"
            pcp: "0"
            descr: "{{ vlan_descr }}"
            vlanif: "{{ vlan_device }}"
      when: >-
        existing_vlans.json.rows
        | selectattr('tag', 'equalto', vlan_id)
        | list | length == 0
      register: vlan_created

    - name: "Reconfigure VLANs"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vlan_settings/reconfigure"
        method: POST
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
        body_format: json
        body: {}
      when: vlan_created.changed

    # -----------------------------------------------------------------------
    # ETAPE 2 - Assignment + Static IPv4 + Activation en forçant l'écriture XML
    # -----------------------------------------------------------------------
    - name: "Vérification si interface déjà assignée dans <interfaces>"
      ansible.builtin.shell:
        cmd: |
          ssh -i {{ ssh_key }} -o StrictHostKeyChecking=no root@{{ api_host }} \
          "awk '/<interfaces>/,/<\/interfaces>/' /conf/config.xml | grep -c '{{ vlan_device }}' || true"
      register: iface_exists
      changed_when: false

    - name: "Récupération du dernier optX utilisé"
      ansible.builtin.shell:
        cmd: |
          ssh -i {{ ssh_key }} -o StrictHostKeyChecking=no root@{{ api_host }} \
          "grep -o 'opt[0-9]*>' /conf/config.xml | grep -o '[0-9]*' | sort -n | tail -1"
      register: last_opt
      changed_when: false
      when: iface_exists.stdout | int == 0

    - name: "Calcul du prochain optX"
      ansible.builtin.set_fact:
        next_opt: "opt{{ (last_opt.stdout | int) + 1 }}"
      when: iface_exists.stdout | int == 0

    - name: "Backup config.xml avant modification"
      ansible.builtin.shell:
        cmd: |
          ssh -i {{ ssh_key }} -o StrictHostKeyChecking=no root@{{ api_host }} \
          "cp /conf/config.xml /conf/config.xml.bak.$(date +%Y%m%d%H%M%S)"
      when: iface_exists.stdout | int == 0
      changed_when: true

    - name: "Injection brutale du bloc interface et purge du cache"
      ansible.builtin.shell:
        cmd: |
          cat << 'EOF' | ssh -i {{ ssh_key }} -o StrictHostKeyChecking=no root@{{ api_host }} "php"
          $xml = simplexml_load_file('/conf/config.xml');
          $iface = $xml->interfaces->addChild('{{ next_opt }}');
          $iface->addChild('if', '{{ vlan_device }}');
          $iface->addChild('descr', '{{ vlan_descr }}');
          $iface->addChild('spoofmac', '');
          $iface->addChild('ipaddr', '{{ ip_locale }}');
          $iface->addChild('subnet', '{{ vip_mask }}');
          $iface->addChild('enable', '1');
          
          $xml->asXML('/conf/config.xml');
          @unlink('/tmp/config.cache');
          echo 'ok';
          EOF
      when: iface_exists.stdout | int == 0
      register: config_injected

    - name: "Application de la configuration interfaces"
      ansible.builtin.shell:
        cmd: |
          ssh -i {{ ssh_key }} -o StrictHostKeyChecking=no root@{{ api_host }} \
          "configctl interface reconfigure {{ next_opt }}"
      when: config_injected.changed

    # -----------------------------------------------------------------------
    # ETAPE 3 - Vérification VHID disponible
    # -----------------------------------------------------------------------
    - name: "Récupération des VIPs existantes"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vip_settings/searchItem"
        method: GET
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
      register: existing_vips

    - name: "Vérification VHID disponible"
      ansible.builtin.assert:
        that:
          - existing_vips.json.rows | selectattr('vhid', 'equalto', vhid) | list | length == 0
        fail_msg: >-
          VHID {{ vhid }} deja utilise !
          VHIDs libres disponibles : {{
            range(1, 256) | list
            | difference(existing_vips.json.rows | map(attribute='vhid') | map('int') | list)
            | list
          }}
        success_msg: "VHID {{ vhid }} disponible"
      when: >-
        existing_vips.json.rows
        | selectattr('vhid', 'equalto', vhid)
        | list | length > 0

    # -----------------------------------------------------------------------
    # ETAPE 4 - Récupération identifiant interface + création VIP CARP
    # -----------------------------------------------------------------------
    - name: "Récupération de l'identifiant interne de l'interface"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vip_settings/getItem"
        method: GET
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
      register: vip_form
      when: >-
        existing_vips.json.rows
        | selectattr('vhid', 'equalto', vhid)
        | list | length == 0

    - name: "Extraction de l'identifiant interface (optX)"
      ansible.builtin.set_fact:
        iface_id: >-
          {{
            vip_form.json.vip.interface
            | dict2items
            | selectattr('value.value', 'equalto', vlan_descr)
            | map(attribute='key')
            | first | default('')
          }}
      when: vip_form is not skipped

    - name: "Abandon si interface non trouvée dans VIP form"
      ansible.builtin.fail:
        msg: >-
          Interface '{{ vlan_descr }}' non trouvée dans la liste des interfaces.
          Vérifier que l'assignment a bien été appliqué sur {{ api_host }}.
      when:
        - vip_form is not skipped
        - iface_id == ''

    - name: "Création VIP CARP {{ vlan_descr }} ({{ 'Primaire' if membre == 1 else 'Slave' }})"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vip_settings/addItem"
        method: POST
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
        body_format: json
        body:
          vip:
            mode: "carp"
            interface: "{{ iface_id }}"
            network: "{{ vip }}"
            gateway: ""
            password: "{{ carp_password }}"
            vhid: "{{ vhid }}"
            advbase: "10"
            advskew: "{{ advskew }}"
            peer: "{{ peer_carp }}"
            peer6: ""
            noexpand: "0"
            nobind: "0"
            descr: "{{ vlan_descr }}"
      when:
        - vip_form is not skipped
        - iface_id != ''
        - existing_vips.json.rows | selectattr('vhid', 'equalto', vhid) | list | length == 0
      register: vip_created

    - name: "Reconfigure VIPs"
      ansible.builtin.uri:
        url: "https://{{ api_host }}/api/interfaces/vip_settings/reconfigure"
        method: POST
        url_username: "{{ api_key }}"
        url_password: "{{ api_secret }}"
        force_basic_auth: true
        validate_certs: "{{ opn_ssl_verify }}"
        timeout: "{{ opn_timeout }}"
        body_format: json
        body: {}
      when:
        - vip_created is not skipped
        - vip_created.changed

    # -----------------------------------------------------------------------
    # RESUME
    # -----------------------------------------------------------------------
    - name: "Résumé"
      ansible.builtin.debug:
        msg:
          - "✅ VLAN     : {{ vlan_descr }} ({{ vlan_device }})"
          - "✅ Interface : {{ next_opt | default('déjà existante') }} (ACTIVÉE)"
          - "✅ IP locale : {{ ip_locale }}/{{ vip_mask }}"
          - "✅ VIP CARP  : {{ vip }} | Peer : {{ peer_carp }} | VHID : {{ vhid }} | Advskew : {{ advskew }}"
