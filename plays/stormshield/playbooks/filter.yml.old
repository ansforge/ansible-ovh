---
- hosts: sns_appliances
  gather_facts: no
  vars_files:
    - ../vars/filter_rules.yml

  tasks:
    # -----------------------------------------------------------
    # ÉTAPE 1 : Créer le séparateur mie_prod
    # -----------------------------------------------------------
    - name: "Créer séparateur mie_prod"
      stormshield.sns.sns_command:
        appliance: "{{ appliance }}"
        script: |
          CONFIG FILTER RULE ADDSEP index={{ sns_filter_slot }} type=filter color=00b0ca comment=mie_prod collapse=0

  roles:
    # -----------------------------------------------------------
    # ÉTAPE 2 : Règles de filtrage (mode add = pas de flush)
    # -----------------------------------------------------------
    - role: stormshield.sns.sns_policy
      slot: "{{ sns_filter_slot }}"
      mode: add
      activate: yes
      filter: "{{ sns_filter_rules }}"
